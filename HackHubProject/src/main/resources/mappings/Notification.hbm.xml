<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="it.hackhub.model.domain.Notification" table="notifications">
        <id name="id" column="id" type="string" length="36">
            <generator class="assigned"/>
        </id>

        <property name="title" column="title" type="string" length="200" not-null="true"/>
        <property name="message" column="message" type="text"/>
        <property name="type" column="type" type="string"/> <property name="createdAt" column="created_at" type="java.time.LocalDateTime"/>
        <property name="read" column="is_read" type="boolean"/>

        <many-to-one name="recipient" class="it.hackhub.model.domain.User"
                     column="recipient_id" not-null="true"/>
    </class>
</hibernate-mapping>