<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="it.hackhub.model.domain.Team" table="teams">
        <id name="id" column="id" type="string" length="36">
            <generator class="assigned"/>
        </id>

        <property name="name" column="name" type="string" length="100" not-null="true"/>

        <many-to-one name="leader" class="it.hackhub.model.domain.User"
                     column="leader_id" not-null="true"/>

        <many-to-one name="registeredHackathon" class="it.hackhub.model.domain.Hackathon"
                     column="hackathon_id" lazy="false"/>

        <bag name="members" table="team_members" cascade="save-update" lazy="false">
            <key column="team_id"/>
            <many-to-many column="user_id" class="it.hackhub.model.domain.User"/>
        </bag>

        <one-to-one name="submission" class="it.hackhub.model.domain.Submission" property-ref="team" cascade="all"/>
    </class>
</hibernate-mapping>