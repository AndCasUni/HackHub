<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="it.hackhub.model.domain.User" table="users">
        <id name="id" column="id" type="string" length="36">
            <generator class="assigned"/>
        </id>

        <property name="username" column="username" type="string" length="50" not-null="true"/>
        <property name="email" column="email" type="string" length="100" not-null="true" unique="true"/>
        <property name="password" column="password" type="string" length="255" not-null="true"/>

        <property name="roleEnum" column="role_enum" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">it.hackhub.model.enums.UserRoleEnum</param>
                <param name="useNamed">true</param>
            </type>
        </property>

        <bag name="assignedHackathons" table="hackathon_staff" inverse="true" lazy="false">
            <key column="user_id"/>
            <many-to-many column="hackathon_id" class="it.hackhub.model.domain.Hackathon"/>
        </bag>

        <bag name="teams" table="team_members" inverse="true" lazy="false">
            <key column="user_id"/>
            <many-to-many column="team_id" class="it.hackhub.model.domain.Team"/>
        </bag>
    </class>
</hibernate-mapping>