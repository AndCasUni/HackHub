<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="it.hackhub.model.domain">
    <class name="it.hackhub.model.domain.Submission" table="submissions">
        <id name="id" column="id" type="string">
            <generator class="assigned"/>
        </id>

        <property name="githubUrl" column="github_url" type="string" length="500"/>
        <property name="demoUrl" column="demo_url" type="string" length="500"/>
        <property name="submittedAt" column="submitted_at" type="java.time.LocalDateTime"/>

        <list name="evaluations" cascade="all" lazy="true">
            <key column="submission_id"/>
            <index column="evaluation_order"/>
            <one-to-many class="it.hackhub.model.domain.Evaluation"/>
        </list>

        <many-to-one name="team" column="team_id" class="it.hackhub.model.domain.Team" unique="true" not-null="true"/>
    </class>
</hibernate-mapping>